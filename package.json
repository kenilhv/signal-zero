{
  "name": "signal-zero",
  "version": "1.0.0",
  "private": true,
  "description": "Signal Zero - ranks settlements by anomalous silence, not report volume. Trishuli GLOF response demo.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "eval": "node evals/run.js",
    "eval:offline": "node evals/run.js --offline",
    "eval:strict": "node evals/run.js --strict",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "eval:sync": "node scripts/sync-eval-readme.mjs",
    "eval:sync:check": "node scripts/sync-eval-readme.mjs --check",
    "test:coverage": "node --experimental-test-coverage --test",
    "openapi:lint": "npx --yes @redocly/cli@2.49.0 lint openapi.yaml",
    "postinstall": "patch-package",
    "trueforge": "node node_modules/@truefoundry/trueforge/dist/cli.js"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "maplibre-gl": "^6.6.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@truefoundry/trueforge": "^0.1.4",
    "patch-package": "^8.0.1"
  }
}
