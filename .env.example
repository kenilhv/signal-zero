# Signal Zero - environment configuration
# Copy to .env and fill in. EVERY value is optional: with no .env at all the app
# still boots and runs the full pipeline against the bundled offline corpus.

# HTTP port for the API + static frontend
PORT=3000

# Bright Data token used by the INGEST stage for live web collection.
# Get one at https://brightdata.com -> Settings -> API keys.
# Leave blank to run ingest from the bundled offline corpus.
BRIGHTDATA_API_TOKEN=

# Bright Data zone names, from Proxies & Scraping Infrastructure in the dashboard.
# List your own with:
#   curl -H "Authorization: Bearer $BRIGHTDATA_API_TOKEN" \
#        https://api.brightdata.com/zone/get_active_zones
# BRIGHTDATA_SERP_ZONE     - a "serp" type zone, used for news/search discovery
# BRIGHTDATA_UNLOCKER_ZONE - an "unblocker" type zone, used to fetch article pages
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# ---------------------------------------------------------------------------
# TRUEFORGE AGENT HARNESS
# ---------------------------------------------------------------------------
# Triage tier 3 - the ONE and only LLM touchpoint in Signal Zero - is executed
# BY the TrueForge harness: src/harness/trueforge.js creates a TrueForge session
# from an AgentSpec and TrueForge runs the turn, resolving the model through its
# own registered provider. We read the answer out of the turn it ran.
#
# Nothing here is load-bearing. If TrueForge is unreachable, tier 3 falls back
# to the direct OPENAI_* fetch below and writes a visible incident that says the
# fallback ran, and GET /api/state reports harness.executedByHarness = 0.
#
# Running a server (it CRASHES on Windows natively - upstream ESM bug, see
# docs/trueforge-verified.md - so run the published package in a container):
#   docker run -d --name tforge -p 4000:4000 -e PORT=4000 -e HOST=0.0.0.0 \
#     node:22-bookworm-slim sh -lc "npx -y @truefoundry/trueforge@latest"
#
# TRUEFORGE_MODEL must be a provider/model name that TrueForge instance has
# registered. List them with:
#   curl -s http://localhost:4000/api/v1/models
# Register an OpenAI-compatible provider with a POST to
# /api/v1/settings/model-providers - the exact body is in
# docs/trueforge-verified.md. Credentials live in TrueForge, not in this file.
TRUEFORGE_ENABLED=true
TRUEFORGE_BASE_URL=http://localhost:4000
TRUEFORGE_MODEL=nebius/signal-zero-triage
# The NAMED agent that executes tier 3. Sessions are bound to it BY NAME
# (POST /api/v1/sessions {"agent":{"name":"..."}}), so the instructions, the
# iteration limit and the tool policy live in TrueForge's registry, not in this
# repo - edit the agent in TrueForge and this pipeline's behaviour changes with
# no redeploy. Register the roster with:
#   node scripts/load-agents.mjs
# List it with:
#   curl -s http://localhost:4000/api/v1/agents
# If this name is absent from the registry, tier 3 still runs through the
# harness but binds an INLINE AgentSpec instead, and the incident feed says so.
TRUEFORGE_AGENT=signal-zero-triage-tier3
# Wall-clock budget for one classification turn, polling included. A turn is
# accepted with HTTP 201 and then RUNS in the background, so this covers the
# poll to a terminal state, not just the request.
TRUEFORGE_TIMEOUT_MS=15000
TRUEFORGE_POLL_MS=350

# LLM credentials. Used ONLY as the tier-3 FALLBACK, for when the TrueForge
# harness above is unreachable or its turn failed. Never dedup, never ranking.
# Leave blank and, if the harness is also unreachable, tier 3 has no executor at
# all - the pipeline still runs, it just leaves genuinely ambiguous items
# UNRESOLVED rather than guessing, and says so in the incident feed.
#
# Any OpenAI-compatible endpoint works. Verified against Nebius Token Factory:
#   OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
#
# Pick a SMALL, FAST model. Tier 3 is a one-line classification called once per
# ambiguous item, so latency compounds across the run. Measured on the real
# prompt, same correct answer from both:
#   meta-llama/Llama-3.3-70B-Instruct    31,644ms  <- blows the 12s timeout
#   Qwen/Qwen3-30B-A3B-Instruct-2507        803ms  <- 39x faster, sparse MoE
# Whole-pipeline effect: 84s -> 37s, and LLM timeouts went 3 -> 0.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# "true" to attempt live scraping via Bright Data, "false" for the offline corpus.
# Ignored (treated as false) when BRIGHTDATA_API_TOKEN is empty.
USE_LIVE_SCRAPE=false
